<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=1920, height=1080">
<title>BlastRadius Agent — recorded working demo</title>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
<style>
* {box-sizing: border-box; margin: 0;}
html,body {width:1920px; height:1080px; overflow:hidden; background:#141b18;}
#root {width:100%; height:100%; padding:56px 64px 40px; color:#eff5ef; font-family:Outfit,sans-serif; display:flex; flex-direction:column; gap:28px;}
header {display:flex; align-items:flex-end; justify-content:space-between; height:118px;}
.eyebrow {font-size:22px; letter-spacing:2px; color:#b7e08a; margin-bottom:10px;}
h1 {font-size:64px; font-weight:700; letter-spacing:-1.5px; line-height:1;}
.meta {font-size:22px; color:#b4c6b8; line-height:1.5; text-align:right;}
main {display:grid; grid-template-columns:1392px 368px; gap:32px; height:752px;}
/* Terminal chrome and discrete-output approach adapted from the installed
   HyperFrames code-terminal-run component. Content is real captured output. */
.ctr-panel {border:2px solid #536b59; border-radius:12px; background:#1e2923; overflow:hidden;}
.ctr-bar {height:52px; border-bottom:2px solid #536b59; display:flex; align-items:center; padding:0 28px; gap:10px;}
.ctr-dot {height:10px; width:10px; border-radius:50%; background:#b4c6b8;}
.bar-label {font-size:19px; margin-left:14px; color:#b4c6b8;}
#output {padding:20px 30px; font-family:"IBM Plex Mono",monospace; font-size:20px; font-weight:400; line-height:26px; white-space:pre; color:#eff5ef;}
aside {display:flex; flex-direction:column; gap:0;}
aside h2 {font-size:25px; font-weight:700; margin-bottom:4px;}
.step {border-bottom:1px solid #536b59; padding:6px 0;}
.step-label {font-size:22px; color:#b4c6b8; margin-bottom:5px;}
.step-tool {font-family:"IBM Plex Mono",monospace; font-size:16px; color:#b4c6b8;}
#caption {font-size:24px; color:#b7e08a; min-height:64px; line-height:1.25; margin-top:auto;}
footer {display:flex; align-items:center; justify-content:space-between; gap:20px; font-size:20px; color:#b4c6b8;}
.track {color:#eff5ef;}
#progress {position:absolute; left:64px; bottom:22px; width:1792px; height:4px; background:#b7e08a; transform-origin:left;}
</style>
</head>
<body>
<div id="root" data-composition-id="main" data-start="0" data-duration="90" data-width="1920" data-height="1080">
<header>
<div><p class="eyebrow">GRAPH HACKS / TRACK 01</p><h1>BlastRadius Agent</h1></div>
<div class="meta"><p>FalkorDB + Sonnet 5.5 + MCP</p><p>A graph-based security fix, proven before apply.</p></div>
</header>
<main>
<section class="ctr-panel"><div class="ctr-bar"><span class="ctr-dot"></span><span class="ctr-dot"></span><span class="ctr-dot"></span><span class="bar-label">Real CLI capture / replay timed for readability</span></div><pre id="output"></pre></section>
<aside><h2>Agent-selected MCP calls</h2>__STEPS__<p id="caption">The graph supplies the facts. The model chooses the tools.</p></aside>
</main>
<footer><span class="track">Agents That Act on Connected Data</span><span>Synthetic IAM · explicit demo auto-approval · source audit included</span></footer>
<div id="progress"></div>
</div>
<script>
const frames = __FRAMES__;
const cues = __CUES__;
const steps = __STEP_NAMES__;
const tl = gsap.timeline({paused:true});
for (const frame of frames) tl.set('#output', {textContent:frame.text}, frame.at);
for (const cue of cues) {
  const i = steps.indexOf(cue.tool);
  if (i >= 0) tl.set('#step-'+i+' .step-label', {color:'#b7e08a'}, cue.at);
}
tl.set('#caption', {textContent:'Cypher finds the external entry path. Centrality ranks its brokers.'}, 26);
tl.set('#caption', {textContent:'The proposed cut is measured on a server-side GRAPH.COPY.'}, 36);
tl.set('#caption', {textContent:'Consent is required. This synthetic demo uses explicit auto-approval.'}, 42);
tl.set('#caption', {textContent:'One approved edge removed. The path and outcome are auditable.'}, 52);
tl.set('#caption', {textContent:'External access closed. All three internal principals retain access.'}, 70);
tl.fromTo('#progress', {scaleX:0}, {scaleX:1,duration:90,ease:'none'}, 0);
window.__timelines['main'] = tl;
</script>
</body>
</html>
